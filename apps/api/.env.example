# App
PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://novel:novel@localhost:5432/novel_platform

# JWT
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Redis
REDIS_URL=redis://localhost:6379
# Colaboración en tiempo real: preparado pero apagado por default (single-instance).
# Poner en "true" solo si el backend escala a más de una instancia y hace falta
# compartir el estado Yjs/awareness entre procesos vía Redis.
COLLAB_USE_REDIS=false

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback

# OAuth — Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/microsoft/callback

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=novel
S3_SECRET_KEY=novelpassword
S3_BUCKET=novel-platform

# IA — Módulo 12
# Voyage AI: embeddings para indexación y búsqueda semántica (RAG). Anthropic no ofrece embeddings propios.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Anthropic: razonamiento/generación (chat, continuar escritura, reescribir, brainstorm)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# OCR — Módulo 9 (Investigación)
# Idiomas de Tesseract separados por "+" (ver https://tesseract-ocr.github.io/tessdoc/Data-Files)
OCR_LANGUAGES=spa+eng
# Tope de páginas por PDF para no disparar tiempos/costos en documentos enormes
OCR_MAX_PDF_PAGES=25

# Transcripción de audio/video — Módulo 9 (Investigación)
# Modelo Whisper (local, vía transformers.js — no es una API de nube). Alternativas:
# Xenova/whisper-tiny (más rápido, menos preciso) / Xenova/whisper-small (más preciso, más lento)
TRANSCRIPTION_MODEL=Xenova/whisper-base
# Idioma esperado del audio, o "auto" para detección automática (más lento)
TRANSCRIPTION_LANGUAGE=spanish
# Tope de minutos por archivo para no disparar tiempos de proceso
TRANSCRIPTION_MAX_MINUTES=30

